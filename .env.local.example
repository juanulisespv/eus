# -----------------------------------------------------------------------------
# VARIABLES DE ENTORNO - APRENDIZAJE DE EUSKERA (SRS)
# Copia este archivo como .env.local y rellena los valores reales.
# -----------------------------------------------------------------------------

# Supabase (Públicas - Accedidas desde el cliente y el servidor)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase (Privadas - ACCESO EXCLUSIVO EN EL SERVIDOR - NUNCA EXPONER)
# Requerido para operaciones administrativas (ej. otorgar logros, scripts)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL del Sitio (Para redirecciones de Auth/OAuth)
# En desarrollo: http://localhost:3000
# En producción: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
