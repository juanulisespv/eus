# =============================================================================
# EUSKERA SRS - CONFIGURACIÓN DE DESARROLLO LOCAL (.env.local)
# Copia este archivo como .env.local y rellena los valores reales de tu proyecto.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Variables Públicas)
# -----------------------------------------------------------------------------
# URL base de tu proyecto Supabase. Se obtiene en Settings > API.
# Utilizado tanto en componentes de cliente (con prefijo NEXT_PUBLIC_) como de servidor.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co

# Clave pública ANON de tu proyecto Supabase. Se obtiene en Settings > API.
# Sirve para acceder de forma segura a la base de datos respetando las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# -----------------------------------------------------------------------------
# 2. Supabase (Variables Privadas - NUNCA EXPONER EN EL CLIENTE)
# -----------------------------------------------------------------------------
# Clave Service Role (service_role secret). Se obtiene en Settings > API.
# ¡CRÍTICO! Esta clave se salta las políticas RLS. Solo se debe usar en el servidor
# o en scripts administrativos independientes (ej. importación de seeds o crons).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# -----------------------------------------------------------------------------
# 3. URLs del Sitio y Autenticación
# -----------------------------------------------------------------------------
# URL base del sitio web. Utilizado para generar enlaces absolutos de redirección
# en el flujo de Supabase Auth (ej. confirmación de correo o restablecimiento).
# En desarrollo local debe apuntar al puerto de tu servidor de desarrollo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
