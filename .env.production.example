# =============================================================================
# EUSKERA SRS - CONFIGURACIÓN DE PRODUCCIÓN (.env.production)
# Configura estas variables en el panel de Vercel (Settings > Environment Variables)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Variables Públicas de Producción)
# -----------------------------------------------------------------------------
# URL base de tu proyecto Supabase de producción.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-produccion-id.supabase.co

# Clave pública ANON de tu proyecto Supabase de producción.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-produccion-aqui

# -----------------------------------------------------------------------------
# 2. Supabase (Variables Privadas de Producción - ACCESO SERVIDOR)
# -----------------------------------------------------------------------------
# Clave Service Role (service_role secret) de tu base de datos de producción.
# Se utiliza en Route Handlers seguros de administración y Server Actions autorizados.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-produccion-aqui

# -----------------------------------------------------------------------------
# 3. URLs del Sitio y Autenticación en Producción
# -----------------------------------------------------------------------------
# URL absoluta de tu aplicación desplegada (ej. Vercel o dominio propio).
# Debe configurarse también en el panel de Supabase Auth (Redirect URLs).
NEXT_PUBLIC_SITE_URL=https://eus-sigma.vercel.app
